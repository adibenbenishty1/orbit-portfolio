# Copy to apps/gate/.env and configure your identity provider.
# These placeholders let the service start; real login needs your own values.
AUTH_PROVIDER_URL=https://provider.invalid
AUTH_CLIENT_ID=replace-with-auth-client-id
AUTH_CLIENT_SECRET=
AUTH_AUTHORIZE_PATH=/authorize
AUTH_TOKEN_PATH=/oauth/token
AUTH_SCOPES=openid email profile groups
GROUPS_CLAIM=groups
GROUP_PREFIX=orbit-
